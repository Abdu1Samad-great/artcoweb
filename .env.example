# Site
NEXT_PUBLIC_SITE_URL=

# Contact details — leave blank until the real details are available.
# Blank values are hidden or shown as "Available on request" in the UI.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
# Separate address lines with |
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_MAPS_EMBED_URL=

# Inquiry delivery
# The form always validates and stores submissions in .data/inquiries.jsonl locally.
# Configure Resend, a webhook, or both for production delivery.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
